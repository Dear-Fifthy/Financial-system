# .env.example (模板文件，需提交到 Git 仓库)
POSTGRES_ADMIN_PASSWORD=your_postgres_admin_password_here
DB_HOST=localhost
DB_PORT=5432
DB_ADMIN_USER=postgres
DB_ADMIN_NAME=postgres

APP_DB_NAME=fin_system_db
APP_DB_USER=finance_app_role
# 应用角色口令：**只存在 .env 里**（.env 已被 .gitignore 挡住，绝不入库）。
#   init_db.sql（入库文件）里只有 __APP_DB_PASS__ 占位符，建库时由
#   database_serv__infra.render_init_sql() 用它替换后再执行：
#     python -m infra.workspace__infra init-db --all      # 推荐（自动注入）
#   手工 psql 跑 init_db.sql 不会被替换，脚本会直接报错提醒。
APP_DB_PASS=your_app_db_password_here

# ===== OCR 运行环境配置（scanner_core 读取）=====
# 设备：auto（自动探测，推荐）| gpu | cpu
OCR_DEVICE=auto
# 显存检查只做提示、不切换设备：空闲显存低于该值(MB)时打印警告仍用 GPU。
# 模型本体需求（提示用，PaddleOCR-VL 约需 6~7G）
OCR_REQUIRED_VRAM_MB=6144
# 警告阈值（不再自动降级 CPU——VL 模型 CPU 单页 12 分钟+，基本不可用）
OCR_MIN_FREE_VRAM_MB=1024
# OCR 连续失败多少次后熔断
OCR_FAIL_THRESHOLD=3
# 单页 predict 超时阈值(秒)：超过记为"慢页"，连续慢页后重建模型
OCR_PAGE_TIMEOUT_S=120
# 连续多少个慢页后重建模型实例一次
OCR_SLOW_REBUILD_LIMIT=2
# 模型重建冷却(秒)：冷却期内失败/慢页不重复重建，防"重复初始化"
OCR_REBUILD_COOLDOWN_S=120
# 进程内模型重建上限：达到后只告警不再重建（防慢环境无限循环加载）
OCR_REBUILD_MAX=3
# 推理引擎：默认 paddle_dynamic（动态图，规避 paddle_static 的 int(Tensor)/EagerParamBase 报错）
# 可选：paddle | paddle_static | paddle_dynamic | transformers | onnxruntime
OCR_ENGINE=paddle_dynamic

# ===== AI API 配置（ai_parser 读取；key 只放 .env，绝不写进代码/仓库）=====
# 总开关：1 启用（hub 处理完自动执行 AI 归档/台账/摘要/向量化），0 关闭
AI_ENABLED=0
AI_API_KEY=sk-your-deepseek-key-here
AI_BASE_URL=https://api.deepseek.com
# 扫描后的分段/概括/抽取统一模型：DeepSeek Flash
AI_MODEL=deepseek-flash
# 结构化 JSON 提取用模型：若 AI_MODEL 在复杂 JSON 任务上只输出思考、content 为空，
# 可单独指定非推理模型
AI_MODEL_JSON=deepseek-flash
AI_TIMEOUT=90
# ===== 全局检索方式（作用于整条检索/核对链路，不按会话选择）=====
# graph=图遍历（默认；沿证据链/因果边，不依赖 embedding）
# rag  =向量检索（保留分块+embedding，走 document_chunks）
RETRIEVAL_METHOD=graph
# RAG 能力总开关（保留 embedding；仅当检索方式=rag 时才会真正执行分块/embedding）
AI_RAG_ENABLED=1

# ===== RAG 分块/向量化配置（rag_store 读取）=====
# 嵌入后端：local（默认，bge-small-zh，需 pip install sentence-transformers）
#          | api（OpenAI 兼容 embedding 接口，如阿里百炼；注意文本会出本机，必须已脱敏）
RAG_EMBED_BACKEND=local
# 嵌入维度：bge-small-zh=512；必须与模型一致
RAG_EMBED_DIM=512
RAG_CHUNK_SIZE=700
# 相邻块重叠字符数（10-20 左右，接缝自动补换行防标签粘连）
RAG_OVERLAP=20
# 切分点浮动窗口(字符)：±该范围找干净落点，保护 text:/paragraph_title: 等英文格式标签完整
RAG_BOUNDARY_FLOAT_CHARS=20
# 本地模型名（RAG_EMBED_BACKEND=local 时使用）
RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 外部 embedding（RAG_EMBED_BACKEND=api 时使用）
RAG_EMBED_API_URL=
RAG_EMBED_API_KEY=
RAG_EMBED_API_MODEL=
# embedding 子进程超时(秒)：首次运行需联网下载模型（约100MB），默认给足余量
RAG_EMBED_TIMEOUT_S=1800

# ===== AI 对话（聊天助手）独立配置（chat_engine 读取）=====
# 对话 AI 与上面"读取/AI 解析链路（AI_API_KEY，DeepSeek）"**完全隔离**：
# 使用独立的 Key 与模型，互不共用。key 只放 .env，绝不写进代码/仓库/日志。
# 默认对接阿里云百炼 Qwen3.8-Max（OpenAI 兼容接口）。
CHAT_AI_API_KEY=sk-your-qwen3.8-max-key-here
# OpenAI 兼容接口地址（默认百炼 compatible-mode；走其它网关/代理时替换）
CHAT_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名：暂定 Qwen3.8-Max（旗舰 API 模型；控制台若显示快照版可写 qwen3.8-max-0902；
# 开放权重版叫 Qwen3.8，勿混淆——以你在百炼开通的模型名为准）
CHAT_AI_MODEL=qwen3.8-max
# 单次请求超时（秒）
CHAT_AI_TIMEOUT=150
# 回答 token 上限（**思考也算在内**：思考多的模型要给足，否则正文被截断）
CHAT_AI_MAX_TOKENS=2000
# ===== 思考过程（reasoning_content）=====
# 实测 qwen3.8-max **默认就返回** message.reasoning_content（思考过程）。
#   CHAT_AI_ENABLE_THINKING：留空=不传该字段（用模型默认，即有思考）；
#                            1=显式开启；0=显式关闭（省 token、更快，但没有思考过程）
CHAT_AI_ENABLE_THINKING=
# 思考 token 上限（可留空）。实测传 256 会让思考更短、并且更倾向用中文思考。
CHAT_AI_THINKING_BUDGET=
# 是否记录思考过程正文（1=记录到 logs/chat/<用户>/<会话>/thinking.jsonl，窗口可折叠查看；
#                            0=只记长度与 token 数，不留正文）
CHAT_AI_RECORD_THINKING=1

# ===== 边发现 AI（证据链/因果边构建，edge 模块读取）=====
# 用途：**所有边**的构建（不限于表格出发）——给定节点/表格栏目/计算目标，让模型
# "考虑周全"地指出应去哪些文档找实际证据；先看概括定位文档，再回原文核对（省 token）。
# 使用 Qwen3.8-Flash；API Key 留空则复用 CHAT_AI_API_KEY / CHAT_AI_BASE_URL。
EDGE_AI_API_KEY=
EDGE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EDGE_AI_MODEL=qwen3.8-flash
EDGE_AI_TIMEOUT=120

# ===== 动态建图（edge 链路）=====
# 机制：每份文档扫描完成 → 后台**单飞队列**建它的节点与关系（入一个建一个）；
#       整批扫完后自动补齐"之前扫过但没建图"的存量（旧→新）；也可在主界面
#       「建图/补齐」窗口手动补齐/重建。
# 注意实测：EDGE 链路是推理模型，**一个候选判定约 35 秒**（10 个候选 ≈ 6 分钟/份），
#           所以候选数与超时值直接影响总耗时。
# 单份文档最多判定多少候选对（越小越快，代价是可能漏掉末尾的弱候选）
EDGE_MAX_PAIRS_PER_DOC=30
# 整批扫描结束后是否自动补齐存量（1=自动，0=只在点「建图/补齐」时跑）
EDGE_AUTO_BACKLOG=1

# ===== 图遍历（L3 查询/核对）独立配置 =====
# 四条链路各自独立、互不复用 key：读取(AI_*)、对话(CHAT_AI_*)、边发现(EDGE_AI_*)、图遍历(GRAPH_AI_*)
# 图遍历走 LLM 沿证据链/因果边取证（非 embedding 向量检索），主用记忆方式。
GRAPH_AI_API_KEY=
GRAPH_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GRAPH_AI_MODEL=qwen3.8-flash
GRAPH_AI_TIMEOUT=120

# ===== 合同判定口径（contract_rules__desens 读取）=====
# 判定规则：文件类型必须是 PDF/Word，且**文件名或标题行**含下列字样之一
# （标题行要求以该字样结尾，避免"合同金额/合同编号"这类栏目被当成标题）。
# 注意：识别只负责"提名"，**入账由用户在「入账审核」窗口人工确认**，不自动写台账。
CONTRACT_TITLE_TOKENS=合同,协议

# ===== 重复文件处理（dedup__desens 读取）=====
# 内容相同的重复件（换路径的复制件/改名件）= 覆盖而不是新增：
#   replace（默认）→ 判定重复时删除原文档的全部痕迹（hub 正文/概括/哈希/事实/节点/边/向量），
#                    用新文件完整重跑；旧编号退役留空，绝不"两份并存"；
#   skip           → 只跳过、保留原文档（旧行为，留作对照）。
# 同一路径重复扫描（内容未变、hub 还在）始终走"跳过"，不会重复新增。
DUP_POLICY=replace
# 强制重扫：1 = 忽略所有内容级去重判断（改了脱敏登记/想整体重跑时用；默认 0）
RESCAN_FORCE=0

# ===== 其它链路（读取/边/图遍历）的思考过程是否写入日志 =====
# 只影响 logs/ai/<chain>_<date>.log 里是否附上 reasoning 正文（默认 1=记录，截断见下）
AI_LOG_REASONING=1
AI_LOG_REASONING_MAX=4000

# ===== AI 输入边界（隐私）=====
# AI 链路**只允许**读 hub/ 里的脱敏产物；input/（原始件）、output/（逐页 OCR 原文缓存）、
# logs/、源目录一律拒绝（见 desens/ai_guard__desens.py：越界抛 AIInputForbidden，并写 logs/ai/guard_*.log）。
# hub 位置默认项目内 ./hub；隔离环境/自测可用下面这项覆盖（留空 = 用默认）：
DSH_HUB_DIR=

# ---- 问答「需求判断」层（query_planner__ai）----
# 1=先判断这个问题「是本机数一下就能答，还是要去找哪几类资料」，再决定动作；
#   计数/清单类问题直接本机统计作答（0 token、不进图遍历），需要资料时按类别召回后核对。
# 0=关闭，完全回到原来的一刀切检索（图遍历 / RAG 全局开关）。
QUERY_PLANNER=1

# 第 0 层「规则快路」开关：1=允许用闭合词表把「多少份/哪些文件/总览」这类**完全可理解**的
#   问题直接本机作答（0 token）；0=连这条快路也不用，所有问题都交给 AI 规划（最保守）。
#   注：规则只做「覆盖度校验」——问句里有词表外的字（条件/分析/第二诉求）就一律交 AI。
QUERY_PLANNER_RULES=1
