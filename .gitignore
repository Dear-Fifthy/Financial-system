# =========================================================
# 运行环境 / 缓存
# =========================================================
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vs/

# =========================================================
# 密钥与本地配置（**绝不入库**）
# ---------------------------------------------------------
# hub_encryption.key 决定密文能不能解开；workspaces/*/hub_encryption.key 是
# "每个仓库各自一把"的密钥。丢了 = 数据永久不可解，进仓库 = 泄露。
# =========================================================
.env
.env.local
hub_encryption.key
**/hub_encryption.key

# =========================================================
# 业务数据与产物（含明文/原文，**绝不入库**）
# ---------------------------------------------------------
# hub/        ：唯一可给 AI 读的脱敏产物根（含概括、特征明文、AI 留痕）
# workspaces/ ：一个仓库一套环境（库+hub+input+output+独立密钥）
# input/      ：源文件投放区（用户原始件，只读）
# output/     ：逐页 OCR 原文级缓存
# logs/       ：运行日志、审计、清理归档、一次性备份
# =========================================================
hub/
workspaces/
input/
output/
logs/

# 万一派生产物落在上面几个目录之外，也别入库
*.ai.log
*.features.json
*.l1.json

# =========================================================
# 本地测试脚手架（**不入库**）
# ---------------------------------------------------------
# sample_docs/ ：合成样例小语料（10 个 hub 格式 JSON + 12 道题真值 + README）。
#   它是**本地测试用**的，不进版本库；需要时照 sample_docs/README.md 重新生成/维护。
#   注意：`sample_corpus__infra.py`（装载/自检/召回对比工具）依赖这个目录，
#   新机器上要先备好 sample_docs/ 才能跑它。
# =========================================================
sample_docs/

# =========================================================
# 临时 / 备份 / 编辑器垃圾
# =========================================================
_tmp_*.py
tmp_*.py
*.tmp
*.bak
*.orig
*~
~$*
.bak_*/
*_bak_*/
Thumbs.db
desktop.ini
.DS_Store

# =========================================================
# 本地协作笔记（**不入库**，2026-09 用户决定）
# ---------------------------------------------------------
# AGENTS.md ：写给我（AI）看的协作约定与踩坑记录，属于**本地工作笔记**，
#   不是交付物、不进版本库。文件留在本地照常生效（删了它 AI 就少了约定）。
# =========================================================
AGENTS.md

# 注意：以下**要入库**，别加进来
#   .env.example       —— 配置模板（口令全是 your_*_here 占位符）
#   init_db.sql / *.py —— 代码与库结构
